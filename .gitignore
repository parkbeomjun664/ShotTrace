# ─────────────────────────────────────────────
#  시크릿 — 절대 커밋 금지
#  한 번 커밋되면 나중에 지워도 git 이력에 영원히 남는다.
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ─────────────────────────────────────────────
#  Node / Next.js
# ─────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# 패키지 매니저 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─────────────────────────────────────────────
#  Python (ETL)
# ─────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# ─────────────────────────────────────────────
#  테스트 / 커버리지
# ─────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# ─────────────────────────────────────────────
#  배포 / 도구
# ─────────────────────────────────────────────
.vercel/
.supabase/
supabase/.temp/
.docker/

# ─────────────────────────────────────────────
#  원본 데이터셋
#  KAMP 공개 데이터. 용량이 크고 저장소가 아니라
#  출처에서 받아야 재현성이 명확하다. README 참고.
# ─────────────────────────────────────────────
data/
*.csv
!docs/**/*.csv

# ─────────────────────────────────────────────
#  OS / 에디터
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~
