# ShotTrace 환경변수 예시
#
# 이 파일은 "키 이름만" 기록한다. 실제 값은 절대 넣지 않는다.
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채운다.
#
#   cp .env.example .env
#
# .env 는 .gitignore 에 있어 커밋되지 않는다.

# ─── Supabase ────────────────────────────────
# NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저 번들에 포함된다 = 전 세계 공개.
# anon key 는 공개돼도 되지만, 그건 RLS 가 켜져 있을 때만 안전하다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key 는 RLS 를 전부 우회한다.
# 서버 사이드와 ETL 스크립트에서만 사용. 절대 NEXT_PUBLIC_ 를 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# ETL 스크립트용 직접 연결 문자열 (M06)
SUPABASE_DB_URL=

# ─── MQTT (M14) ──────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID_SIMULATOR=shottrace-simulator
MQTT_CLIENT_ID_COLLECTOR=shottrace-collector

# ─── 시뮬레이터 (M13) ─────────────────────────
# 재생 배속. 1 = 실시간, 60 = 1분을 1초로, 3600 = 1시간을 1초로
SIMULATOR_SPEED=60
SIMULATOR_CSV_PATH=./data/labeled_data.csv

# ─── LLM (M23) ───────────────────────────────
# 서버에서만 사용한다. 클라이언트에서 호출하면 키가 공개된다.
ANTHROPIC_API_KEY=
